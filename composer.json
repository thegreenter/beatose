{
    "name": "greenter/beatose",
    "description": "OSE SUNAT SOAP Server",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ext-soap": "*",
        "ext-xsl": "*",
        "ext-zlib": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "greenter/cpe-validator": "^5.4",
        "greenter/ubl-validator": "^2.3",
        "greenter/ws": "^5.4",
        "greenter/xcodes": "^5.4",
        "greenter/xmldsig": "^5.1",
        "nelexa/zip": "^4.1",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*",
        "thecodingmachine/safe": "^3.4",
        "twig/extra-bundle": "^3.29",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/maker-bundle": "^1.68"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts",
            "@php composer/XsltDownloader.php",
            "@php composer/DoctrineMigrations.php"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": "phpstan analyse",
        "lint:ci": "phpstan analyse --error-format=github",
        "test": "phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
